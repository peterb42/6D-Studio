{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Studio starten",
      "type": "shell",
      "command": "${workspaceFolder}/bin/6d-fernsteuerung studio",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Studio stoppen",
      "type": "shell",
      "command": "${workspaceFolder}/bin/6d-fernsteuerung stop",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Studio neu starten",
      "dependsOrder": "sequence",
      "dependsOn": ["Studio stoppen", "Studio starten"],
      "problemMatcher": []
    },
    {
      "label": "Studio-Protokoll verfolgen",
      "type": "shell",
      "command": "tail -n 40 -f ~/.gphoto/6d-proxy.log",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Simulator + Studio starten",
      "type": "shell",
      "command": "${workspaceFolder}/bin/6d-fernsteuerung sim",
      "problemMatcher": []
    },
    {
      "label": "Simulator stoppen",
      "type": "shell",
      "command": "${workspaceFolder}/bin/6d-fernsteuerung sim-stop; true",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Simulator-Protokoll verfolgen",
      "type": "shell",
      "command": "tail -n 40 -f ~/.gphoto/6d-sim.log ~/.gphoto/6d-sim-studio.log",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Status",
      "type": "shell",
      "command": "${workspaceFolder}/bin/6d-fernsteuerung status",
      "problemMatcher": []
    },
    {
      "label": "Tests",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m unittest discover -s tests -v",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Lint (ruff)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/ruff check studio sim tools tests",
      "problemMatcher": []
    },
    {
      "label": "venv einrichten",
      "type": "shell",
      "command": "/opt/homebrew/bin/python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt",
      "problemMatcher": []
    },
    {
      "label": "Installieren (Symlinks)",
      "type": "shell",
      "command": "${workspaceFolder}/install.sh",
      "problemMatcher": []
    },
    {
      "label": "Kamera-Fähigkeiten auslesen",
      "type": "shell",
      "command": "${command:python.interpreterPath} tools/ptp-caps.py",
      "problemMatcher": []
    }
  ]
}
