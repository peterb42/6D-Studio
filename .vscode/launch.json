{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "6D Studio (Debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/studio/6d-studio.py",
      "args": ["172.20.10.3"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Studio stoppen"
    },
    {
      "name": "Simulator (6D)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/sim/sim6d.py",
      "args": ["--port", "15741", "--verbose", "--raw", "--sky-speed", "60"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Studio gegen Simulator",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/studio/6d-studio.py",
      "args": ["127.0.0.1"],
      "env": {
        "CAM_PORT": "15741",
        "GPHOTO_PORT": "15742",
        "STUDIO_PORT": "8067",
        "OUT": "${env:HOME}/Pictures/6D-Tethering/Simulator"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Tests (Debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Kopplung testen (ptpip-handshake)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/ptpip-handshake.py",
      "args": ["172.20.10.3"],
      "console": "integratedTerminal",
      "preLaunchTask": "Studio stoppen"
    }
  ],
  "compounds": [
    {
      "name": "Simulator + Studio (Debug)",
      "configurations": ["Simulator (6D)", "Studio gegen Simulator"],
      "preLaunchTask": "Simulator stoppen",
      "stopAll": true
    }
  ]
}
